# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Orçah"

# PostgreSQL / Supabase
# DATABASE_URL: pooler/transação para a aplicação.
# DIRECT_URL: conexão direta/session pooler para operações do Prisma.
# Nunca commite credenciais reais.
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:SENHA@aws-0-region.pooler.supabase.com:5432/postgres"

# Sessão local (troque em produção)
AUTH_SECRET="troque-isto-em-producao"

# Ponte server-to-server: mesmo segredo nos dois projetos, >= 32 bytes.
CONTROL_INTERNAL_SECRET=""
# IA opcional. Sem ambas as variáveis, o Assistente usa a base local.
OPENAI_API_KEY=""
SUPPORT_AI_MODEL=""

# Admin não vem mais de env: é users.role = ADMIN (definido por processo interno).

# Recuperação de senha (Resend). Sem estas duas, /recuperar-senha responde "indisponível".
# O link do e-mail usa NEXT_PUBLIC_APP_URL (Preview da Vercel usa VERCEL_URL automaticamente).
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Orçah <nao-responda@seu-dominio.com.br>"

# Asaas
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""

# Supabase Storage (fotos da página: logo, galeria, serviços). Só no servidor, nunca no navegador.
# Sem estas duas, o envio de fotos fica desligado na Vercel (em dev local salva em public/uploads).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# opcional; padrão company-assets (criado automaticamente como bucket público de leitura)
SUPABASE_STORAGE_BUCKET="company-assets"
